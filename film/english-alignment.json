  "records": [
    {
      "id": "life-1",
      "start": 0.35,
      "end": 5.694145833333334,
      "chineseStart": 0.55,
      "chineseEnd": 5.4558125,
      "rawSeconds": 4.7247,
      "tempo": 0.88,
      "spokenText": "Last lesson, five students formed two teams. This project needs three teams."
    },
    {
      "id": "life-2",
      "start": 6.2441458333333335,
      "end": 10.547625,
      "chineseStart": 6.501875,
      "chineseEnd": 10.5004375,
      "rawSeconds": 3.8068,
      "tempo": 0.88,
      "spokenText": "Frequent collaborators still want to stay together and reduce cross-team coordination."
    },
    {
      "id": "life-3",
      "start": 11.097625,
      "end": 15.944333333333333,
      "chineseStart": 11.5465,
      "chineseEnd": 16.853729166666668,
      "rawSeconds": 4.2888,
      "tempo": 0.88,
      "spokenText": "Can we reuse the old grouping when two teams become three? Start with the everyday problem."
    },
    {
      "id": "capacity-1",
      "start": 16.894333333333332,
      "end": 22.250520833333333,
      "chineseStart": 18.705854166666665,
      "chineseEnd": 23.569375,
      "rawSeconds": 4.7317,
      "tempo": 0.88,
      "spokenText": "There are three worktables, each holding at most two students. Every team must be nonempty."
    },
    {
      "id": "capacity-2",
      "start": 22.800520833333334,
      "end": 27.267541666666666,
      "chineseStart": 23.989375,
      "chineseEnd": 28.726145833333334,
      "rawSeconds": 3.9493,
      "tempo": 0.88,
      "spokenText": "With five students assigned, the sizes must be 2, 2 and 1, in any order."
    },
    {
      "id": "capacity-3",
      "start": 27.817541666666667,
      "end": 33.26227083333333,
      "chineseStart": 29.146145833333332,
      "chineseEnd": 34.43597916666667,
      "rawSeconds": 4.8166,
      "tempo": 0.88,
      "spokenText": "A grouping must satisfy capacity and should reduce cross-team coordination. Check both."
    },
    {
      "id": "model-1",
      "start": 34.212270833333335,
      "end": 39.500770833333334,
      "chineseStart": 35.285979166666664,
      "chineseEnd": 40.068104166666664,
      "rawSeconds": 4.6746,
      "tempo": 0.88,
      "spokenText": "Replace the students with vertices A through E. Edges represent collaboration, with numerical weights."
    },
    {
      "id": "model-2",
      "start": 40.05077083333333,
      "end": 43.861375,
      "chineseStart": 41.04591666666666,
      "chineseEnd": 45.584125,
      "rawSeconds": 3.3689,
      "tempo": 0.88,
      "spokenText": "A B and D E each have weight 5: two closely connected pairs."
    },
    {
      "id": "model-3",
      "start": 44.411375,
      "end": 49.505291666666665,
      "chineseStart": 46.5619375,
      "chineseEnd": 52.58685416666667,
      "rawSeconds": 4.4998,
      "tempo": 0.88,
      "spokenText": "The other four edges are A C: 1, B C: 4, C D: 2 and C E: 1."
    },
    {
      "id": "objective-1",
      "start": 50.45529166666667,
      "end": 56.91466666666667,
      "chineseStart": 54.5525,
      "chineseEnd": 60.023854166666666,
      "rawSeconds": 5.7213,
      "tempo": 0.88,
      "spokenText": "Assign a partition to each vertex. An edge contributes to the cut only when its endpoints are in different partitions."
    },
    {
      "id": "objective-2",
      "start": 57.464666666666666,
      "end": 61.95977083333333,
      "chineseStart": 61.27008333333333,
      "chineseEnd": 65.93679166666666,
      "rawSeconds": 3.9762,
      "tempo": 0.88,
      "spokenText": "Add the weights of all crossing edges to obtain the weighted cut cost, or cut size."
    },
    {
      "id": "objective-3",
      "start": 62.509770833333334,
      "end": 67.42329166666667,
      "chineseStart": 67.18302083333333,
      "chineseEnd": 71.86458333333333,
      "rawSeconds": 4.3451,
      "tempo": 0.88,
      "spokenText": "This is an undirected graph. Count each edge once; internal edges do not enter this sum."
    },
    {
      "id": "roundrobin-1",
      "start": 68.37329166666666,
      "end": 73.821375,
      "chineseStart": 74.11704166666667,
      "chineseEnd": 79.19183333333334,
      "rawSeconds": 4.8158,
      "tempo": 0.88,
      "spokenText": "Assign seats in alphabetical round-robin order: A to team 1, B to team 2 and C to team 3."
    },
    {
      "id": "roundrobin-2",
      "start": 74.371375,
      "end": 79.70179166666667,
      "chineseStart": 79.61183333333334,
      "chineseEnd": 86.18577083333334,
      "rawSeconds": 4.713,
      "tempo": 0.88,
      "spokenText": "Then D returns to team 1 and E goes to team 2. The groups are A D, B E and C."
    },
    {
      "id": "roundrobin-3",
      "start": 80.25179166666666,
      "end": 86.4233125,
      "chineseStart": 86.60577083333334,
      "chineseEnd": 91.7164375,
      "rawSeconds": 5.5191,
      "tempo": 0.88,
      "spokenText": "The sizes are 2, 2 and 1, so capacity is satisfied. But what happens to the connections?"
    },
    {
      "id": "roundcut-1",
      "start": 87.3733125,
      "end": 92.6298125,
      "chineseStart": 92.5664375,
      "chineseEnd": 98.28479166666666,
      "rawSeconds": 4.6498,
      "tempo": 0.88,
      "spokenText": "Inspect each edge. Both edges of weight 5 cross, and so do the other four edges."
    },
    {
      "id": "roundcut-2",
      "start": 93.1798125,
      "end": 99.48072916666666,
      "chineseStart": 99.00239583333334,
      "chineseEnd": 104.49625,
      "rawSeconds": 5.5669,
      "tempo": 0.88,
      "spokenText": "The cut is 5 + 1 + 4 + 2 + 5 + 1 = 18. No edge stays inside a group."
    },
    {
      "id": "roundcut-3",
      "start": 100.03072916666666,
      "end": 106.38508333333333,
      "chineseStart": 105.21385416666666,
      "chineseEnd": 110.85645833333334,
      "rawSeconds": 5.6137,
      "tempo": 0.88,
      "spokenText": "Round robin is quick but only follows the ordering. Balanced counts do not imply a small connection cost."
    },
    {
      "id": "recurseidea-1",
      "start": 107.33508333333333,
      "end": 113.21947916666667,
      "chineseStart": 112.13183333333333,
      "chineseEnd": 119.18685416666666,
      "rawSeconds": 5.1976,
      "tempo": 0.88,
      "spokenText": "Recursive bisection repeatedly splits one part into two. Each cut adds one part; stop at three."
    },
    {
      "id": "recurseidea-2",
      "start": 113.76947916666667,
      "end": 119.51729166666667,
      "chineseStart": 119.6469375,
      "chineseEnd": 125.65170833333333,
      "rawSeconds": 5.1139,
      "tempo": 0.88,
      "spokenText": "This baseline always splits a part with the most nodes. A bisection here need not have equal counts."
    },
    {
      "id": "recurseidea-3",
      "start": 120.06729166666666,
      "end": 126.63416666666667,
      "chineseStart": 126.11179166666666,
      "chineseEnd": 132.49427083333333,
      "rawSeconds": 5.7998,
      "tempo": 0.88,
      "spokenText": "That is the outer process. How is each cut chosen? Next, spectral bisection makes that decision explicit."
    },
    {
      "id": "inputorder-1",
      "start": 127.58416666666666,
      "end": 132.68691666666666,
      "chineseStart": 133.4244375,
      "chineseEnd": 139.45785416666666,
      "rawSeconds": 4.5111,
      "tempo": 0.88,
      "spokenText": "A through E are node names. Alphabetical order only fixes the input indexing."
    },
    {
      "id": "inputorder-2",
      "start": 133.23691666666667,
      "end": 139.3418125,
      "chineseStart": 141.4511875,
      "chineseEnd": 146.88804166666668,
      "rawSeconds": 5.3924,
      "tempo": 0.88,
      "spokenText": "Round robin uses that order directly. Spectral bisection computes a new position from the connections."
    },
    {
      "id": "spectralidea-1",
      "start": 140.2918125,
      "end": 145.78822916666667,
      "chineseStart": 150.88472916666666,
      "chineseEnd": 155.31852083333334,
      "rawSeconds": 4.864,
      "tempo": 0.88,
      "spokenText": "Imagine each edge as a spring. A heavier edge penalizes a larger distance between its endpoints."
    },
    {
      "id": "spectralidea-2",
      "start": 146.33822916666668,
      "end": 151.021125,
      "chineseStart": 157.80922916666665,
      "chineseEnd": 164.490125,
      "rawSeconds": 4.1454,
      "tempo": 0.88,
      "spokenText": "Assign coordinates and minimize the sum of each edge weight times its squared coordinate difference."
    },
    {
      "id": "spectralidea-3",
      "start": 151.571125,
      "end": 157.00964583333334,
      "chineseStart": 166.98083333333332,
      "chineseEnd": 174.24875,
      "rawSeconds": 4.8052,
      "tempo": 0.88,
      "spokenText": "Require zero coordinate sum and unit squared norm, fixing center and scale and preventing collapse."
    },
    {
      "id": "laplacian-1",
      "start": 157.95964583333333,
      "end": 162.73547916666666,
      "chineseStart": 179.24014583333334,
      "chineseEnd": 186.36641666666668,
      "rawSeconds": 4.2252,
      "tempo": 0.88,
      "spokenText": "Build the Laplacian: weighted degree on the diagonal and negative edge weight off the diagonal."
    },
    {
      "id": "laplacian-2",
      "start": 163.28547916666668,
      "end": 170.07402083333332,
      "chineseStart": 189.00166666666667,
      "chineseEnd": 195.96189583333333,
      "rawSeconds": 5.9961,
      "tempo": 0.88,
      "spokenText": "A connects to B with weight five and C with weight one. Its row is six, minus five, minus one, zero, zero."
    },
    {
      "id": "laplacian-3",
      "start": 170.62402083333333,
      "end": 176.97125,
      "chineseStart": 198.59714583333334,
      "chineseEnd": 205.61016666666666,
      "rawSeconds": 5.6086,
      "tempo": 0.88,
      "spokenText": "Missing edges give zero. Alphabetical row and column indices identify nodes; the new order comes next."
    },
    {
      "id": "fiedler-1",
      "start": 177.92125,
      "end": 183.97641666666667,
      "chineseStart": 210.89070833333332,
      "chineseEnd": 217.71775,
      "rawSeconds": 5.3542,
      "tempo": 0.88,
      "spokenText": "For this connected graph, the coordinate problem is solved by an eigenvector for the second-smallest Laplacian eigenvalue."
    },
    {
      "id": "fiedler-2",
      "start": 184.52641666666668,
      "end": 190.852375,
      "chineseStart": 219.87820833333333,
      "chineseEnd": 226.9946875,
      "rawSeconds": 5.5874,
      "tempo": 0.88,
      "spokenText": "This is the Fiedler vector. The smallest eigenvalue has constant coordinates, which give no useful distinction."
    },
    {
      "id": "fiedler-3",
      "start": 191.402375,
      "end": 197.96341666666666,
      "chineseStart": 229.15514583333334,
      "chineseEnd": 237.24095833333334,
      "rawSeconds": 5.7921,
      "tempo": 0.88,
      "spokenText": "The course code approximates it in eighty iterations: approximately solve a linear system, remove the mean, then normalize."
    },
    {
      "id": "spectralorder-1",
      "start": 198.91341666666668,
      "end": 203.54614583333333,
      "chineseStart": 241.34804166666666,
      "chineseEnd": 246.44241666666667,
      "rawSeconds": 4.1018,
      "tempo": 0.88,
      "spokenText": "The computed coordinates place D near E and A near B, with C between those pairs."
    },
    {
      "id": "spectralorder-2",
      "start": 204.09614583333334,
      "end": 208.26177083333334,
      "chineseStart": 246.87552083333333,
      "chineseEnd": 254.748625,
      "rawSeconds": 3.6846,
      "tempo": 0.88,
      "spokenText": "Sorting coordinates from smallest to largest gives E, D, C, B, A."
    },
    {
      "id": "spectralorder-3",
      "start": 208.81177083333333,
      "end": 214.49416666666667,
      "chineseStart": 255.18172916666666,
      "chineseEnd": 262.73575,
      "rawSeconds": 5.0249,
      "tempo": 0.88,
      "spokenText": "The coordinates generate an ordering. We must still compare actual cut costs to choose a partition."
    },
    {
      "id": "sweep-1",
      "start": 215.44416666666666,
      "end": 220.7931875,
      "chineseStart": 263.6119791666667,
      "chineseEnd": 270.63216666666665,
      "rawSeconds": 4.7828,
      "tempo": 0.88,
      "spokenText": "There are four adjacent cut positions. Isolating E cuts D E and C E, for cost six."
    },
    {
      "id": "sweep-2",
      "start": 221.3431875,
      "end": 225.21085416666668,
      "chineseStart": 272.0061875,
      "chineseEnd": 276.9466458333333,
      "rawSeconds": 3.4186,
      "tempo": 0.88,
      "spokenText": "Putting E and D on the left cuts only C D and C E, for cost three."
    },
    {
      "id": "sweep-3",
      "start": 225.76085416666666,
      "end": 230.69133333333335,
      "chineseStart": 278.3206666666667,
      "chineseEnd": 284.38558333333333,
      "rawSeconds": 4.3647,
      "tempo": 0.88,
      "spokenText": "Putting E, D and C on the left costs five. Leaving only A on the right costs six."
    },
    {
      "id": "sweep-4",
      "start": 231.24133333333333,
      "end": 239.3430625,
      "chineseStart": 285.7596041666667,
      "chineseEnd": 294.49291666666664,
      "rawSeconds": 7.143,
      "tempo": 0.88,
      "spokenText": "All four pass the local area filter. Choose the smallest cost, three. This sweep does not guarantee a global optimum on every graph."
    },
    {
      "id": "firstsplit-1",
      "start": 240.2930625,
      "end": 245.4344375,
      "chineseStart": 297.06041666666664,
      "chineseEnd": 302.41929166666665,
      "rawSeconds": 4.5451,
      "tempo": 0.88,
      "spokenText": "After comparing all four candidates, choose A, B, C on one side and D, E on the other."
    },
    {
      "id": "firstsplit-2",
      "start": 245.9844375,
      "end": 251.525375,
      "chineseStart": 302.8690208333333,
      "chineseEnd": 308.4871875,
      "rawSeconds": 4.8983,
      "tempo": 0.88,
      "spokenText": "Only C D and C E cross between the sides. Their weights sum to 2 + 1 = 3."
    },
    {
      "id": "firstsplit-3",
      "start": 252.075375,
      "end": 257.20214583333336,
      "chineseStart": 308.93691666666666,
      "chineseEnd": 314.4325625,
      "rawSeconds": 4.526,
      "tempo": 0.88,
      "spokenText": "Both heavy edges A B and D E stay internal. But we still have only two groups."
    },
    {
      "id": "subgraph-1",
      "start": 258.15214583333335,
      "end": 262.715625,
      "chineseStart": 315.0920208333333,
      "chineseEnd": 322.3525833333333,
      "rawSeconds": 4.0375,
      "tempo": 0.88,
      "spokenText": "We now have A B C and D E. The three-node part is larger, so it is split next."
    },
    {
      "id": "subgraph-2",
      "start": 263.265625,
      "end": 269.52725,
      "chineseStart": 322.77258333333333,
      "chineseEnd": 330.63104166666665,
      "rawSeconds": 5.5322,
      "tempo": 0.88,
      "spokenText": "Keep only the internal edges A B, A C and B C. Previously cut edges do not enter this coordinate calculation."
    },
    {
      "id": "subgraph-3",
      "start": 270.07725,
      "end": 276.47235416666666,
      "chineseStart": 331.05104166666666,
      "chineseEnd": 340.07839583333333,
      "rawSeconds": 5.6527,
      "tempo": 0.88,
      "spokenText": "Rebuild the subgraph Laplacian and coordinates, giving the new order A, B, C. Each split is computed afresh."
    },
    {
      "id": "secondsweep-1",
      "start": 277.42235416666665,
      "end": 283.9916875,
      "chineseStart": 340.92839583333335,
      "chineseEnd": 349.2332916666667,
      "rawSeconds": 5.8044,
      "tempo": 0.88,
      "spokenText": "Along A, B, C there are two candidates. Isolating A cuts A B and A C, for five plus one, or six."
    },
    {
      "id": "secondsweep-2",
      "start": 284.5416875,
      "end": 290.9099375,
      "chineseStart": 350.614125,
      "chineseEnd": 358.6790833333333,
      "rawSeconds": 5.6304,
      "tempo": 0.88,
      "spokenText": "Keeping A B together and isolating C cuts A C and B C, for one plus four, or five. Choose this cut."
    },
    {
      "id": "secondsplit-1",
      "start": 291.8599375,
      "end": 296.47622916666666,
      "chineseStart": 361.2007708333333,
      "chineseEnd": 366.5420208333333,
      "rawSeconds": 4.0766,
      "tempo": 0.88,
      "spokenText": "Following that comparison, split A B C into A B and C. We now have three parts."
    },
    {
      "id": "secondsplit-2",
      "start": 297.02622916666667,
      "end": 301.7241875,
      "chineseStart": 366.9620208333333,
      "chineseEnd": 371.95216666666664,
      "rawSeconds": 4.1551,
      "tempo": 0.88,
      "spokenText": "This split adds crossing edges A C and B C, with weights 1 + 4 = 5."
    },
    {
      "id": "secondsplit-3",
      "start": 302.2741875,
      "end": 307.80572916666665,
      "chineseStart": 372.37216666666666,
      "chineseEnd": 379.86364583333335,
      "rawSeconds": 4.8794,
      "tempo": 0.88,
      "spokenText": "The final groups are A B, C and D E. Their sizes are 2, 1 and 2, all within capacity."
    },
    {
      "id": "cumulative-1",
      "start": 308.75572916666664,
      "end": 314.01514583333335,
      "chineseStart": 380.7136458333333,
      "chineseEnd": 384.954,
      "rawSeconds": 4.6448,
      "tempo": 0.88,
      "spokenText": "The second cut of 5 is an additional cost. The first cut of 3 still exists."
    },
    {
      "id": "cumulative-2",
      "start": 314.56514583333336,
      "end": 320.808875,
      "chineseStart": 386.09279166666664,
      "chineseEnd": 390.86347916666665,
      "rawSeconds": 5.5141,
      "tempo": 0.88,
      "spokenText": "The final cut cost is therefore 3 + 5 = 8. Reporting only the last split's 5 would be wrong."
    },
    {
      "id": "cumulative-3",
      "start": 321.358875,
      "end": 327.37766666666664,
      "chineseStart": 392.00227083333334,
      "chineseEnd": 398.02122916666667,
      "rawSeconds": 5.3135,
      "tempo": 0.88,
      "spokenText": "Recounting the final graph gives 1 + 4 + 2 + 1 = 8: four crossing edges, each counted once."
    },
    {
      "id": "compare-1",
      "start": 328.3276666666667,
      "end": 334.9745833333333,
      "chineseStart": 400.22535416666665,
      "chineseEnd": 405.2756875,
      "rawSeconds": 5.8677,
      "tempo": 0.88,
      "spokenText": "Compare the results side by side. Both have two groups of 2 and one group of 1, satisfying the same capacity."
    },
    {
      "id": "compare-2",
      "start": 335.52458333333334,
      "end": 340.8504375,
      "chineseStart": 405.7789375,
      "chineseEnd": 411.8188125,
      "rawSeconds": 4.7123,
      "tempo": 0.88,
      "spokenText": "The difference is the two edges of weight 5. Keeping A B and D E internal saves 10."
    },
    {
      "id": "compare-3",
      "start": 341.4004375,
      "end": 347.1569583333333,
      "chineseStart": 412.3220625,
      "chineseEnd": 417.5473125,
      "rawSeconds": 5.0846,
      "tempo": 0.88,
      "spokenText": "Eighteen minus eight is ten. We optimize connection structure, so the size bars alone are not enough."
    },
    {
      "id": "direct-1",
      "start": 348.10695833333335,
      "end": 353.6088125,
      "chineseStart": 418.5638125,
      "chineseEnd": 423.730875,
      "rawSeconds": 4.8652,
      "tempo": 0.88,
      "spokenText": "Direct multiway partitioning maintains several partitions directly, without requiring a binary split tree."
    },
    {
      "id": "direct-2",
      "start": 354.1588125,
      "end": 361.3452291666667,
      "chineseStart": 424.480625,
      "chineseEnd": 430.0693958333333,
      "rawSeconds": 6.3499,
      "tempo": 0.88,
      "spokenText": "Round robin is only our simple starting point. It ignores edge weights and does not represent all direct multiway algorithms."
    },
    {
      "id": "direct-3",
      "start": 361.89522916666664,
      "end": 367.0771041666667,
      "chineseStart": 430.8191458333333,
      "chineseEnd": 435.85516666666666,
      "rawSeconds": 4.5852,
      "tempo": 0.88,
      "spokenText": "Direct methods can compare gains from moves or swaps and refine the grouping within capacity limits."
    },
    {
      "id": "refinement-1",
      "start": 368.0271041666667,
      "end": 373.1389375,
      "chineseStart": 437.1146875,
      "chineseEnd": 441.46045833333335,
      "rawSeconds": 4.5157,
      "tempo": 0.88,
      "spokenText": "Return to the round-robin result. Try swapping D from team 1 with B from team 2."
    },
    {
      "id": "refinement-2",
      "start": 373.6889375,
      "end": 379.6007916666667,
      "chineseStart": 441.8804583333333,
      "chineseEnd": 448.30789583333336,
      "rawSeconds": 5.215,
      "tempo": 0.88,
      "spokenText": "We get A B, D E and C. Sizes stay unchanged, and the cost drops from 18 to 8, a gain of 10."
    },
    {
      "id": "refinement-3",
      "start": 380.1507916666667,
      "end": 386.5515208333333,
      "chineseStart": 448.7278958333333,
      "chineseEnd": 454.6110625,
      "rawSeconds": 5.6522,
      "tempo": 0.88,
      "spokenText": "This illustrates a greedy pair swap. It explains refinement moves, but is not a complete multiway FM algorithm."
